{
  "name": "@nbtca/calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate.mjs",
    "check": "pnpm build && node --test",
    "dev": "wrangler dev",
    "import:school": "node scripts/import-google-calendar.mjs",
    "sync": "node sync/run.js",
    "test": "node --test",
    "deploy": "pnpm check && wrangler deploy",
    "deploy:sync": "pnpm check && wrangler deploy -c sync/wrangler.jsonc"
  },
  "devDependencies": {
    "ical.js": "^2.2.1",
    "wrangler": "^4.129.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0"
}
